<?xml version='1.0' encoding='UTF-8'?>
<pyvcp>
    <label>
        <text>"Spindle speed:"</text>
    </label>
    <bar>
        <halpin>"spindle-speed"</halpin>
        <max_>5000</max_>
    </bar>

    <labelframe text="Set Coordinate System">
        <vbox>
            <hbox>
                <boxanchor anchor="center"/>
                <boxexpand expand="y"/>
                <button>
                    <relief>GROOVE</relief>
                    <text>"Y-top"</text>
                    <bd>3</bd>
                </button>
            </hbox>
            <hbox>
                <boxanchor anchor="center"/>
                <boxexpand expand="n"/>
                <button>
                    <relief>GROOVE</relief>
                    <text>"X-left"</text>
                    <bd>3</bd>
                </button>
                <button>
                    <relief>GROOVE</relief>
                    <text>"Z"</text>
                    <bd>3</bd>
                </button>
                <button>
                    <relief>GROOVE</relief>
                    <text>"X-right"</text>
                    <bd>3</bd>
                </button>
            </hbox>
                <button>
                    <relief>GROOVE</relief>
                    <text>"Y-bottom"</text>
                    <bd>3</bd>
                </button>
        </vbox>
    </labelframe>

</pyvcp>
